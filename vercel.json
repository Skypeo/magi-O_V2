{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/nos-services/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services-plomberie-colmar/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/case-studies/",
      "destination": "/realisations/",
      "permanent": true
    },
    {
      "source": "/nos-realisations/",
      "destination": "/realisations/",
      "permanent": true
    },
    {
      "source": "/service/plombier-colmar-travaux-plomberie/",
      "destination": "/services/plomberie/",
      "permanent": true
    },
    {
      "source": "/service-category/plomberie/",
      "destination": "/services/plomberie/",
      "permanent": true
    },
    {
      "source": "/service/chauffagiste-colmar/",
      "destination": "/services/chauffage/",
      "permanent": true
    },
    {
      "source": "/service-category/chauffage/",
      "destination": "/services/chauffage/",
      "permanent": true
    },
    {
      "source": "/pompe-a-chaleur-colmar/",
      "destination": "/services/chauffage/",
      "permanent": true
    },
    {
      "source": "/services/pompe-a-chaleur/",
      "destination": "/services/chauffage/",
      "permanent": true
    },
    {
      "source": "/service/detection-de-fuite/",
      "destination": "/services/detection-de-fuite/",
      "permanent": true
    },
    {
      "source": "/service-category/detection-de-fuite/",
      "destination": "/services/detection-de-fuite/",
      "permanent": true
    },
    {
      "source": "/service/electricien-colmar/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/service-category/electricite/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/electricite/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/partenariat-pro/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/realisations/electricite/",
      "destination": "/realisations/",
      "permanent": true
    },
    {
      "source": "/realisations/chauffage/",
      "destination": "/realisations/",
      "permanent": true
    },
    {
      "source": "/case/electricite/",
      "destination": "/realisations/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://api.web3forms.com; img-src 'self' data: https://cdn.sanity.io; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.web3forms.com; frame-src https://www.google.com https://maps.google.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
