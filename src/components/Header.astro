---
import Icon from './Icon.astro';
import { NAV, CONTACT, SOCIAL, SITE, SERVICES } from '../consts';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="relative z-50">
  <!-- Barre mobile / tablette : logo + burger, épinglée en haut -->
  <div
    class="fixed inset-x-0 top-0 z-40 flex h-16 items-center justify-between bg-cream/95 px-5 backdrop-blur lg:hidden"
  >
    <a href="/" aria-label={`${SITE.name} — accueil`}>
      <img src="/images/logo.png" alt={SITE.name} width="130" height="36" class="h-9 w-auto" />
    </a>
    <button
      id="menu-toggle"
      class="-mr-2 flex h-11 w-11 items-center justify-center rounded-xl text-pine-700 transition hover:bg-pine-50"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="h-7 w-7 [stroke-width:2.25]" />
    </button>
  </div>
  <!-- Réserve l'espace de la barre fixe (mobile/tablette uniquement) -->
  <div class="h-16 lg:hidden"></div>

  <!-- Barre utilitaire -->
  <div class="mx-auto hidden max-w-7xl items-center justify-between gap-6 px-6 py-4 lg:flex">
    <a href="/" class="shrink-0" aria-label={`${SITE.name} — accueil`}>
      <img
        src="/images/logo.png"
        alt={`Logo ${SITE.name} — Plombier chauffagiste à ${SITE.city}`}
        width="180"
        height="50"
        class="h-12 w-auto"
      />
    </a>
    <div class="flex items-center gap-8">
      <a href={`mailto:${CONTACT.email}`} class="group flex items-center gap-3">
        <span class="flex h-11 w-11 items-center justify-center rounded-full border border-pine-200 text-pine-500 transition group-hover:bg-pine-500 group-hover:text-white">
          <Icon name="mail" class="h-5 w-5" />
        </span>
        <span class="leading-tight">
          <span class="block text-sm font-semibold text-ink">Nous écrire</span>
          <span class="block text-sm text-pine-600">{CONTACT.email}</span>
        </span>
      </a>
      <a href="/contact" class="group flex items-center gap-3">
        <span class="flex h-11 w-11 items-center justify-center rounded-full border border-pine-200 text-pine-500 transition group-hover:bg-pine-500 group-hover:text-white">
          <Icon name="clock" class="h-5 w-5" />
        </span>
        <span class="leading-tight">
          <span class="block text-sm font-semibold text-ink">Horaires</span>
          <span class="block text-sm text-pine-600">{CONTACT.hours}</span>
        </span>
      </a>
    </div>
  </div>

  <!-- Nav en pill (reprise de l'ancien site) — desktop uniquement.
       Marge négative en bas : la pill déborde « à cheval » sur la hero. -->
  <div class="mx-auto hidden max-w-7xl px-4 lg:relative lg:z-30 lg:-mb-11 lg:block lg:px-6 lg:pt-0">
    <nav
      class="flex items-center justify-between gap-4 rounded-pill bg-pine-500 px-3 py-3 text-white shadow-soft lg:px-4"
      aria-label="Navigation principale"
    >
      <!-- Liens desktop -->
      <ul class="hidden items-center gap-7 pl-4 lg:flex">
        {
          NAV.map((item) =>
            item.href === '/services' ? (
              <li class="group/dd relative">
                <a
                  href={item.href}
                  class="nav-link inline-flex items-center gap-1 text-[15px] font-medium text-white/95 transition hover:text-white"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition group-hover/dd:rotate-180 group-focus-within/dd:rotate-180"><path d="m6 9 6 6 6-6" /></svg>
                </a>
                <!-- Panneau déroulant -->
                <div class="invisible absolute left-1/2 top-full z-50 w-64 -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover/dd:visible group-hover/dd:translate-y-0 group-hover/dd:opacity-100 group-focus-within/dd:visible group-focus-within/dd:translate-y-0 group-focus-within/dd:opacity-100">
                  <ul class="overflow-hidden rounded-2xl bg-white p-2 text-ink shadow-card ring-1 ring-pine-100">
                    {SERVICES.map((s) => (
                      <li>
                        <a
                          href={`/services/${s.slug}`}
                          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-[15px] font-medium transition hover:bg-pine-50 hover:text-pine-600"
                        >
                          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-pine-50 text-pine-500">
                            <Icon name={s.icon} class="h-4 w-4" />
                          </span>
                          {s.navLabel}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="nav-link text-[15px] font-medium text-white/95 transition hover:text-white"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>

      <!-- Réseaux + CTA desktop -->
      <div class="hidden items-center gap-4 lg:flex">
        <a
          href={SOCIAL.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20"
        >
          <Icon name="facebook" class="h-4 w-4" />
        </a>
        <a
          href={SOCIAL.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20"
        >
          <Icon name="instagram" class="h-4 w-4" />
        </a>
        <a
          href={`tel:${CONTACT.phoneRaw}`}
          class="group flex items-center gap-3 rounded-pill bg-white py-2 pl-2 pr-5 shadow-sm transition hover:shadow-md"
        >
          <span class="animate-pulse-ring flex h-10 w-10 items-center justify-center rounded-full bg-coral-500 text-white">
            <Icon name="phone" class="h-5 w-5" />
          </span>
          <span class="leading-tight">
            <span class="block text-[15px] font-bold text-ink">{CONTACT.phone}</span>
            <span class="block text-xs text-pine-600">Contact rapide</span>
          </span>
        </a>
      </div>
    </nav>
  </div>

  <!-- Barre fixe au scroll (desktop) — apparaît en glissant du haut -->
  <div
    id="sticky-nav"
    class="fixed inset-x-0 top-0 z-50 hidden -translate-y-full bg-cream/95 shadow-md backdrop-blur transition-transform duration-300 ease-out lg:block"
  >
    <div class="flex items-stretch">
      <!-- Logo dans bloc vert, collé au bord gauche -->
      <a href="/" class="flex shrink-0 items-center rounded-br-[2.5rem] bg-pine-700 py-4 pl-8 pr-14" aria-label={`${SITE.name} — accueil`}>
        <img src="/images/logo.png" alt={SITE.name} width="150" height="42" class="h-10 w-auto brightness-0 invert" />
      </a>

      <!-- Contenu (nav + tél + CTA) -->
      <div class="flex flex-1 items-center justify-between gap-8 pl-10 pr-8">
      <!-- Liens -->
      <ul class="flex items-center gap-7">
        {
          NAV.map((item) =>
            item.href === '/services' ? (
              <li class="group/sd relative flex items-center">
                <a
                  href={item.href}
                  class="inline-flex items-center gap-1 text-[15px] font-medium text-ink/80 transition hover:text-pine-600"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition group-hover/sd:rotate-180 group-focus-within/sd:rotate-180"><path d="m6 9 6 6 6-6" /></svg>
                </a>
                <div class="invisible absolute left-1/2 top-full z-50 w-64 -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover/sd:visible group-hover/sd:translate-y-0 group-hover/sd:opacity-100 group-focus-within/sd:visible group-focus-within/sd:translate-y-0 group-focus-within/sd:opacity-100">
                  <ul class="overflow-hidden rounded-2xl bg-white p-2 text-ink shadow-card ring-1 ring-pine-100">
                    {SERVICES.map((s) => (
                      <li>
                        <a
                          href={`/services/${s.slug}`}
                          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-[15px] font-medium transition hover:bg-pine-50 hover:text-pine-600"
                        >
                          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-pine-50 text-pine-500">
                            <Icon name={s.icon} class="h-4 w-4" />
                          </span>
                          {s.navLabel}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li class="flex items-center">
                <a
                  href={item.href}
                  class:list={[
                    'text-[15px] font-medium transition hover:text-pine-600',
                    isActive(item.href) ? 'font-semibold text-pine-600' : 'text-ink/80',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>

      <!-- Téléphone + CTA -->
      <div class="flex items-center gap-5">
        <a href={`tel:${CONTACT.phoneRaw}`} class="group flex items-center gap-3">
          <span class="animate-pulse-ring flex h-11 w-11 items-center justify-center rounded-full bg-coral-500 text-white">
            <Icon name="phone" class="h-5 w-5" />
          </span>
          <span class="leading-tight">
            <span class="block text-[15px] font-bold text-ink">{CONTACT.phone}</span>
            <span class="block text-xs text-pine-600">Contact rapide</span>
          </span>
        </a>
        <a
          href="/contact"
          class="rounded-2xl bg-pine-700 px-6 py-3 font-semibold text-white transition hover:bg-pine-800"
        >
          Contactez nous
        </a>
      </div>
      </div>
    </div>
  </div>

  <!-- Menu off-canvas (mobile / tablette) -->
  <div
    id="menu-backdrop"
    class="invisible fixed inset-0 z-40 bg-ink/60 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"
  ></div>

  <aside
    id="mobile-menu"
    class="fixed right-0 top-0 z-50 flex h-[100dvh] w-[86%] max-w-sm translate-x-full flex-col bg-pine-700 text-white shadow-2xl transition-transform duration-300 ease-out lg:hidden"
    aria-hidden="true"
  >
    <!-- Décor -->
    <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-pine-500/40 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-16 h-56 w-56 rounded-full bg-coral-500/15 blur-3xl"></div>

    <!-- En-tête du panneau -->
    <div class="relative flex items-center justify-between border-b border-white/10 px-6 py-5">
      <img src="/images/logo.png" alt={SITE.name} width="130" height="36" class="h-9 w-auto brightness-0 invert" />
      <button
        id="menu-close"
        class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20"
        aria-label="Fermer le menu"
      >
        <Icon name="close" class="h-6 w-6" />
      </button>
    </div>

    <!-- Liens -->
    <nav class="relative flex-1 overflow-y-auto px-5 py-6" aria-label="Menu mobile">
      <ul class="flex flex-col gap-1 text-lg font-semibold">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between rounded-2xl px-4 py-3 transition hover:bg-white/10"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.href === '/services' && (
                <ul class="mb-2 ml-4 mt-1 space-y-0.5 border-l border-white/15 pl-3">
                  {SERVICES.map((s) => (
                    <li>
                      <a
                        href={`/services/${s.slug}`}
                        class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-[15px] font-medium text-white/70 transition hover:bg-white/10 hover:text-white"
                      >
                        <Icon name={s.icon} class="h-4 w-4 text-pine-300" />
                        {s.navLabel}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Pied du panneau -->
    <div class="relative border-t border-white/10 px-6 pb-8 pt-5">
      <a
        href={`tel:${CONTACT.phoneRaw}`}
        class="flex items-center justify-center gap-3 rounded-pill bg-coral-500 px-6 py-3.5 font-bold text-white shadow-lg shadow-coral-500/30 transition hover:bg-coral-600"
      >
        <Icon name="phone" class="h-5 w-5" />
        {CONTACT.phone}
      </a>
      <div class="mt-5 flex items-center justify-center gap-4">
        <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition hover:bg-coral-500">
          <Icon name="facebook" class="h-5 w-5" />
        </a>
        <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition hover:bg-coral-500">
          <Icon name="instagram" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </aside>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('menu-toggle');
    const close = document.getElementById('menu-close');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('menu-backdrop');
    if (!toggle || !menu || !backdrop) return;
    let open = false;
    const set = (v) => {
      open = v;
      menu.classList.toggle('translate-x-full', !open);
      menu.classList.toggle('translate-x-0', open);
      menu.setAttribute('aria-hidden', String(!open));
      backdrop.classList.toggle('invisible', !open);
      backdrop.classList.toggle('opacity-0', !open);
      backdrop.classList.toggle('opacity-100', open);
      document.body.style.overflow = open ? 'hidden' : '';
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => set(true));
    close.addEventListener('click', () => set(false));
    backdrop.addEventListener('click', () => set(false));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) set(false);
    });

    // Barre fixe : apparaît une fois la pill du haut dépassée.
    const sticky = document.getElementById('sticky-nav');
    if (sticky) {
      let visible = false;
      let ticking = false;
      const update = () => {
        const show = window.scrollY > 260;
        if (show !== visible) {
          visible = show;
          sticky.classList.toggle('-translate-y-full', !show);
          sticky.classList.toggle('translate-y-0', show);
        }
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      update();
    }
  })();
</script>
