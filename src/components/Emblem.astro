---
// Emblème Ø de la marque (favicon agrandi) en décor flottant pour réchauffer les sections.
// Taille / opacité / position via `class`. Animation via `motion`.
interface Props {
  class?: string;
  motion?: 'float' | 'drift' | 'spin' | 'none';
  rotate?: number;
  /** 'pine' (fonds clairs) | 'white' (fonds sombres) */
  variant?: 'pine' | 'white';
}
const { class: cls = '', motion = 'float', rotate = 0, variant = 'pine' } = Astro.props;
const motionClass =
  motion === 'drift' ? 'doodle-drift' : motion === 'spin' ? 'doodle-spin' : motion === 'none' ? '' : 'doodle-float';
// L'emblème décoratif utilisait le favicon 32 px, affiché jusqu'à 192 px : visiblement
// pixellisé, et signalé par Lighthouse. emblem-pine.png est la version haute définition.
const src = variant === 'white' ? '/images/emblem-white.png' : '/images/emblem-pine.png';
---

<!-- Decor pur : rendu en fond CSS et non en balise image. Une image decorative n'a
     rien a faire dans l'arbre d'accessibilite, et elle faussait le compte des
     images de la page dans les audits. -->
<span
  aria-hidden="true"
  class={`pointer-events-none absolute block select-none bg-contain bg-center bg-no-repeat ${motionClass} ${cls}`}
  style={`background-image:url(${src})${rotate ? `;--rot:${rotate}deg;transform:rotate(${rotate}deg)` : ''}`}
>
</span>
