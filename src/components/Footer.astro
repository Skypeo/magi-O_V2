---
import Icon from './Icon.astro';
import { NAV, CONTACT, SOCIAL, SITE, SERVICES } from '../consts';
const year = 2026;
---

<footer class="relative mt-24 overflow-hidden bg-pine-700 text-white">
  <div class="pointer-events-none absolute -right-20 -top-24 h-80 w-80 rounded-full bg-pine-500/40 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-coral-500/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Marque -->
      <div>
        <img src="/images/logo.png" alt={SITE.name} width="170" height="47" class="h-12 w-auto brightness-0 invert" />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/70">
          Votre artisan plombier, chauffagiste et électricien à {SITE.city}. Plus de 10 ans d'expérience au service de votre confort.
        </p>
        <div class="mt-6 flex gap-3">
          <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-coral-500">
            <Icon name="facebook" class="h-5 w-5" />
          </a>
          <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-coral-500">
            <Icon name="instagram" class="h-5 w-5" />
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-pine-300">Navigation</h3>
        <ul class="mt-5 space-y-3 text-sm">
          {NAV.map((item) => (
            <li>
              <a href={item.href} class="text-white/75 transition hover:text-white">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-pine-300">Nos services</h3>
        <ul class="mt-5 space-y-3 text-sm">
          {SERVICES.slice(0, 5).map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="text-white/75 transition hover:text-white">{s.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-pine-300">Contact</h3>
        <ul class="mt-5 space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <Icon name="phone" class="mt-0.5 h-5 w-5 shrink-0 text-pine-300" />
            <a href={`tel:${CONTACT.phoneRaw}`} class="text-white/85 transition hover:text-white">{CONTACT.phone}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="mail" class="mt-0.5 h-5 w-5 shrink-0 text-pine-300" />
            <a href={`mailto:${CONTACT.email}`} class="break-all text-white/85 transition hover:text-white">{CONTACT.email}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-pine-300" />
            <span class="text-white/85">{CONTACT.address}, {CONTACT.zip} {CONTACT.cityName}</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-pine-300" />
            <span class="text-white/85">{CONTACT.hours}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-white/55 md:flex-row">
      <p>© {year} {SITE.name}. Tous droits réservés.</p>
      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2" aria-label="Liens légaux">
        <a href="/mentions-legales" class="transition hover:text-white">Mentions légales</a>
        <a href="/politique-de-confidentialite" class="transition hover:text-white">Politique de confidentialité</a>
        <button type="button" data-cookie-settings class="transition hover:text-white">Gérer les cookies</button>
      </nav>
    </div>
    <p class="mt-6 text-center text-xs text-white/40 md:text-right">
      Plomberie · Chauffage · Électricité · Détection de fuite à {SITE.city}
    </p>
  </div>

  <script is:inline>
    document.querySelectorAll('[data-cookie-settings]').forEach((b) =>
      b.addEventListener('click', () => window.magioConsent?.open())
    );
  </script>
</footer>
