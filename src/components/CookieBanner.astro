---
// Bandeau de consentement cookies — conforme CNIL :
//  • aucun cookie/service tiers (Google Maps) chargé avant consentement
//  • « Refuser » aussi accessible qu'« Accepter » (même niveau)
//  • choix mémorisé (localStorage) et modifiable à tout moment (lien footer)
// L'API window.magioConsent expose get()/set()/open() et émet l'évènement
// « magio:consent » (detail = 'granted' | 'denied') pour piloter les contenus tiers.
---

<div
  id="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-label="Gestion des cookies"
  class="fixed inset-x-3 bottom-3 z-[60] hidden sm:inset-x-auto sm:bottom-5 sm:left-5 sm:max-w-md"
>
  <div class="rounded-2xl border border-pine-100 bg-white p-5 shadow-card sm:p-6">
    <div class="flex items-start gap-3">
      <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-pine-50 text-pine-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
          <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5Z" />
          <path d="M8.5 8.5h.01M16 15.5h.01M11 17h.01M13.5 11h.01" />
        </svg>
      </span>
      <div>
        <h2 class="text-base font-bold text-ink">Nous respectons votre vie privée</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-pine-700/80">
          Ce site n'utilise pas de cookies publicitaires. Nous souhaitons seulement charger la
          <strong>carte Google Maps</strong> sur la page contact, qui dépose des cookies. Vous pouvez l'accepter ou la refuser.
        </p>
      </div>
    </div>

    <div class="mt-4 flex flex-col gap-2.5 sm:flex-row">
      <button type="button" data-consent="denied" class="order-2 flex-1 rounded-pill border border-pine-200 px-5 py-2.5 text-sm font-semibold text-pine-700 transition hover:bg-pine-50 sm:order-1">
        Refuser
      </button>
      <button type="button" data-consent="granted" class="order-1 flex-1 rounded-pill bg-coral-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-coral-500/30 transition hover:bg-coral-600 sm:order-2">
        Tout accepter
      </button>
    </div>
    <p class="mt-3 text-center text-xs text-pine-700/80 sm:text-left">
      En savoir plus : <a href="/politique-de-confidentialite" class="underline underline-offset-2 transition hover:text-coral-500">politique de confidentialité</a>
    </p>
  </div>
</div>

<script is:inline>
  (() => {
    const KEY = 'magio_cookie_consent';
    const banner = document.getElementById('cookie-banner');

    const api = {
      get() {
        try { return localStorage.getItem(KEY); } catch { return null; }
      },
      set(value) {
        try { localStorage.setItem(KEY, value); } catch {}
        hide();
        document.dispatchEvent(new CustomEvent('magio:consent', { detail: value }));
      },
      open() { show(); },
    };
    window.magioConsent = api;

    function show() { banner && banner.classList.remove('hidden'); }
    function hide() { banner && banner.classList.add('hidden'); }

    // Affiche le bandeau uniquement si aucun choix n'a encore été fait.
    if (!api.get()) show();

    // Si un choix existe déjà, on (re)diffuse l'évènement pour piloter les contenus tiers.
    else document.dispatchEvent(new CustomEvent('magio:consent', { detail: api.get() }));

    banner?.querySelectorAll('[data-consent]').forEach((btn) => {
      btn.addEventListener('click', () => api.set(btn.getAttribute('data-consent')));
    });
  })();
</script>
