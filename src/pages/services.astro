---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import Emblem from '../components/Emblem.astro';
import { SERVICES, CONTACT } from '../consts';
---

<Layout
  seoTitle="Plomberie, chauffage et détection de fuite à Colmar"
  description="Toutes les prestations MAGI O à Colmar : plomberie, rénovation de salle de bain et PMR, chauffage et pompe à chaleur, recherche de fuite sans casse."
  breadcrumb={[{ name: 'Accueil', url: '/' }, { name: 'Nos services' }]}
>
  <PageHeader
    eyebrow="Nos prestations"
    title="Nos services de plomberie et chauffage à Colmar"
    subtitle="Un seul artisan pour la plomberie, la rénovation de salle de bain, le chauffage et la détection de fuite à Colmar et ses environs."
  />

  <section class="relative overflow-hidden py-20">
    <!-- Emblème Ø filigrane flottant -->
    <Emblem class="-right-12 top-16 h-44 w-44 opacity-[0.06]" motion="drift" rotate={8} />
    <Emblem class="bottom-10 left-0 hidden h-28 w-28 opacity-[0.05] lg:block" motion="float" />
    <div class="relative mx-auto max-w-7xl px-6">
    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        SERVICES.map((s, i) => (
          <a
            href={`/services/${s.slug}`}
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
            class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-soft transition hover:-translate-y-1 hover:shadow-card"
          >
            <div class="relative h-52 overflow-hidden">
              <img src={s.image} alt={s.title} width="500" height="320" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/50 to-transparent" />
              <span class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white/90 text-pine-500 backdrop-blur">
                <Icon name={s.icon} class="h-6 w-6" />
              </span>
              <h2 class="absolute bottom-4 left-4 right-4 text-xl font-bold text-white">{s.title}</h2>
            </div>
            <div class="flex flex-1 flex-col p-6">
              {s.subtitle && <p class="mb-1 text-sm font-semibold text-coral-500">{s.subtitle}</p>}
              <p class="flex-1 text-[15px] leading-relaxed text-pine-700/80">{s.description}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-coral-500">
                Découvrir le service
                <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
    </div>
  </section>

  <!-- CTA -->
  <Cta
    title="Une question sur nos services ?"
    text="Appelez-nous ou demandez un devis gratuit : on vous conseille avec plaisir."
  />
</Layout>
