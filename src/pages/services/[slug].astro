---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';
import Emblem from '../../components/Emblem.astro';
import SpinBadge from '../../components/SpinBadge.astro';
import Framed from '../../components/Framed.astro';
import { SERVICES, CONTACT, SITE } from '../../consts';

export function getStaticPaths() {
  // Les services « standalone » (ex. pompe à chaleur) ont leur propre page dédiée.
  return SERVICES.filter((s) => !s.standalone).map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

// Image plombier commune à toutes les pages services (fond orange) — demande cliente
const HERO_IMAGE = '/images/service-de-reparation-de-plomberie-1-1-1.webp';

// Paragraphes d'introduction : `lead` si défini (texte exact ancien site), sinon l'intro courte
const leadParagraphs = service.lead ?? [service.intro];
---

<Layout
  seoTitle={service.seoTitle}
  description={service.description}
  image={service.image}
  service={service}
  faq={service.faq}
  breadcrumb={[
    { name: 'Accueil', url: '/' },
    { name: 'Nos services', url: '/services/' },
    { name: service.navLabel },
  ]}
>
  <!-- ===== Hero — image plombier, voile orange brûlé profond (toutes les pages services) ===== -->
  <section class="relative mt-4 overflow-hidden bg-[#3d1206] text-white">
    <!-- Image plombier bien visible + voile orange profond dégradé -->
    <div class="absolute inset-0">
      <img
        src={HERO_IMAGE}
        alt=""
        class="h-full w-full object-cover object-center"
        fetchpriority="high"
        width="1200"
        height="700"
      />
      <!-- Voile orange brûlé profond : très dense à gauche, photo visible à droite -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#5e1606]/95 via-coral-700/80 to-coral-700/40"></div>
      <!-- Vignette sombre chaude marquée pour la profondeur (orange feutré, jamais criard) -->
      <div class="absolute inset-0 bg-gradient-to-t from-pine-900/70 via-pine-900/15 to-pine-900/35"></div>
    </div>

    <!-- Hachures qui défilent + orbe qui respire -->
    <div class="hatch-light hatch-pan pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="animate-blob pointer-events-none absolute -left-16 top-10 h-56 w-56 rounded-full bg-white/10 blur-3xl" style="--o:0.6"></div>

    <!-- Badge circulaire rotatif -->
    <SpinBadge class="absolute right-8 top-1/2 hidden h-28 w-28 -translate-y-1/2 drop-shadow-xl lg:block" />

    <div class="relative mx-auto max-w-7xl px-6 pb-24 pt-20 lg:pb-28 lg:pt-24">
      <nav class="mb-6 flex items-center gap-2 text-sm text-white/75" aria-label="Fil d'Ariane">
        <a href="/" class="transition hover:text-white">Accueil</a>
        <span>/</span>
        <a href="/services" class="transition hover:text-white">Services</a>
        <span>/</span>
        <span class="text-white">{service.title}</span>
      </nav>

      <div class="fade-up flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15 text-white ring-1 ring-white/25 backdrop-blur-sm">
        <Icon name={service.icon} class="h-8 w-8" />
      </div>
      <h1 class="fade-up fade-up-1 mt-6 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">{service.h1 ?? service.title}</h1>
      {service.subtitle && (
        <p class="fade-up fade-up-2 mt-3 text-xl font-semibold text-white/95">{service.subtitle}</p>
      )}
      <p class="fade-up fade-up-3 mt-5 max-w-2xl text-lg leading-relaxed text-white/90">{service.description}</p>

      <div class="fade-up fade-up-3 mt-8 flex flex-wrap gap-4">
        <a href="/contact" class="btn-sheen group inline-flex items-center gap-2 rounded-pill bg-white px-7 py-4 font-semibold text-coral-600 shadow-lg shadow-coral-900/20 transition hover:bg-pine-50">
          Devis gratuit
          <Icon name="arrow" class="h-5 w-5 transition group-hover:translate-x-1" />
        </a>
        <a href={`tel:${CONTACT.phoneRaw}`} class="inline-flex items-center gap-2 rounded-pill bg-white/15 px-7 py-4 font-semibold text-white ring-1 ring-white/30 backdrop-blur-sm transition hover:bg-white/25">
          <Icon name="phone" class="h-5 w-5" />
          {CONTACT.phone}
        </a>
      </div>
    </div>

    <!-- Vague de raccord (couleur crème = fond du site) -->
    <div class="absolute -bottom-px left-0 right-0 leading-[0]">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 80V40C240 70 480 75 720 55C960 35 1200 5 1440 25V80H0Z" fill="#f5f8f6" />
      </svg>
    </div>
  </section>

  <!-- ===== Contenu + sidebar « autres services » ===== -->
  <section class="relative overflow-hidden px-6 py-16 lg:py-20">
    <!-- Emblème Ø filigrane -->
    <Emblem class="-right-16 top-24 h-48 w-48 opacity-[0.05]" motion="drift" rotate={6} />
    <div class="relative mx-auto grid max-w-7xl gap-10 lg:grid-cols-[290px_1fr] lg:gap-14">
      <!-- Sidebar : tous les services, cliquables (sticky) -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-coral-500">Nos services</p>
        <nav class="mt-4 flex flex-col gap-2.5" aria-label="Tous nos services">
          {
            SERVICES.filter((s) => !s.standalone).map((s) => {
              const active = s.slug === service.slug;
              return (
                <a
                  href={`/services/${s.slug}`}
                  aria-current={active ? 'page' : undefined}
                  class={`group flex items-center gap-3 rounded-2xl border px-4 py-3.5 transition ${
                    active
                      ? 'border-pine-500 bg-pine-700 text-white shadow-soft'
                      : 'border-pine-100 bg-white text-ink hover:-translate-y-0.5 hover:border-pine-200 hover:shadow-soft'
                  }`}
                >
                  <span
                    class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl transition ${
                      active ? 'bg-white/15 text-white' : 'bg-pine-50 text-pine-500 group-hover:bg-pine-500 group-hover:text-white'
                    }`}
                  >
                    <Icon name={s.icon} class="h-5 w-5" />
                  </span>
                  <span class="flex-1 text-sm font-semibold leading-tight">{s.navLabel}</span>
                  <Icon
                    name="arrow"
                    class={`h-4 w-4 shrink-0 transition group-hover:translate-x-1 ${active ? 'text-white' : 'text-pine-300'}`}
                  />
                </a>
              );
            })
          }
        </nav>

        <!-- Carte contact -->
        <div class="mt-6 rounded-2xl bg-pine-700 p-6 text-white">
          <p class="text-sm font-semibold">Une question, une urgence ?</p>
          <p class="mt-1 text-sm text-white/75">Nous vous répondons rapidement.</p>
          <a
            href={`tel:${CONTACT.phoneRaw}`}
            class="mt-4 inline-flex items-center gap-2 rounded-pill bg-coral-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-coral-600"
          >
            <Icon name="phone" class="h-4 w-4" />
            {CONTACT.phone}
          </a>
        </div>
      </aside>

      <!-- Contenu principal -->
      <div>
        <div data-reveal>
          <h2 class="inline-block text-3xl font-bold text-ink sm:text-4xl">
            <Framed>{service.title}</Framed>
          </h2>
        </div>

        <!-- Introduction (texte exact ancien site) -->
        <div data-reveal data-reveal-delay="1" class="mt-6 space-y-4">
          {leadParagraphs.map((p) => <p class="text-lg leading-relaxed text-pine-700/85">{p}</p>)}
        </div>

        <!-- Sections détaillées (mise en page alternée avec photos) -->
        <div class="mt-12 space-y-14">
          {
            service.sections.map((sec, i) => {
              const flip = i % 2 === 1; // alterne le côté du média
              const hasMedia = Boolean(sec.image || sec.video);
              return (
                <article
                  data-reveal
                  class={`grid items-center gap-7 ${hasMedia ? 'lg:grid-cols-2 lg:gap-10' : ''}`}
                >
                  {/* Média : vidéo si fournie, sinon photo */}
                  {hasMedia && (
                    <div class={`group relative ${flip ? 'lg:order-2' : ''}`}>
                      <div class="overflow-hidden rounded-3xl shadow-card ring-1 ring-pine-100">
                        {sec.video ? (
                          <video
                            src={sec.video}
                            poster={sec.poster}
                            controls
                            muted
                            playsinline
                            preload="metadata"
                            class="aspect-[3/2] w-full bg-ink object-contain"
                          />
                        ) : (
                          <img
                            src={sec.image}
                            alt={sec.heading}
                            loading="lazy"
                            width="600"
                            height="400"
                            class="aspect-[3/2] w-full object-cover transition duration-700 group-hover:scale-105"
                          />
                        )}
                      </div>
                      {/* petit liseré corail décoratif */}
                      <span class={`pointer-events-none absolute -z-10 h-24 w-24 rounded-3xl bg-coral-500/15 ${flip ? '-right-4 -top-4' : '-left-4 -bottom-4'}`} />
                    </div>
                  )}

                  {/* Texte */}
                  <div class={hasMedia && flip ? 'lg:order-1' : ''}>
                    <h3 class="flex items-center gap-3 text-2xl font-bold text-ink">
                      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-pine-50 text-pine-500">
                        <Icon name="check" class="h-5 w-5" />
                      </span>
                      {sec.heading}
                    </h3>
                    <span class="mt-4 block h-0.5 w-12 rounded-full bg-coral-500" />

                    {sec.paragraphs && (
                      <div class="mt-5 space-y-4">
                        {sec.paragraphs.map((p) => (
                          <p class="leading-relaxed text-pine-700/85">{p}</p>
                        ))}
                      </div>
                    )}
                    {sec.text && <p class="mt-5 leading-relaxed text-pine-700/85">{sec.text}</p>}
                    {sec.items && (
                      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                        {sec.items.map((it) => (
                          <li class="flex items-start gap-2.5 text-[15px] text-pine-700/85">
                            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-coral-500" />
                            {it}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              );
            })
          }
        </div>

        <!-- Bloc mis en avant (ex. « Pourquoi passer à la pompe à chaleur ? ») -->
        {
          service.callout && (
            <div
              data-reveal
              class="relative mt-14 overflow-hidden rounded-[2rem] bg-pine-700 p-8 text-white shadow-card sm:p-10"
            >
              <span class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-coral-500/15 blur-2xl" />
              <div class="relative">
                <h3 class="flex items-center gap-3 text-2xl font-bold text-white">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15 text-white">
                    <Icon name={service.icon} class="h-6 w-6" />
                  </span>
                  {service.callout.title}
                </h3>
                <div class="mt-5 space-y-4">
                  {service.callout.paragraphs.map((p) => (
                    <p class="leading-relaxed text-white/85">{p}</p>
                  ))}
                </div>
                <a
                  href="/contact"
                  class="group mt-7 inline-flex items-center gap-2 rounded-pill bg-coral-500 px-6 py-3 font-semibold text-white transition hover:bg-coral-600"
                >
                  Demander un devis
                  <Icon name="arrow" class="h-5 w-5 transition group-hover:translate-x-1" />
                </a>
              </div>
            </div>
          )
        }

        <!-- Page fille mise en avant (ex. remplacement chaudiere vers PAC) -->
        {
          service.approfondir && (
            <a
              href={service.approfondir.href}
              data-reveal
              class="group relative mt-14 block overflow-hidden rounded-[2rem] bg-pine-700 p-8 text-white shadow-card transition hover:-translate-y-1 sm:p-10"
            >
              <span class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-coral-500/15 blur-2xl" />
              <div class="relative">
                <h3 class="flex items-center gap-3 text-2xl font-bold text-white">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15 text-white">
                    <Icon name={service.icon} class="h-6 w-6" />
                  </span>
                  {service.approfondir.titre}
                </h3>
                <p class="mt-5 leading-relaxed text-white/85">{service.approfondir.texte}</p>
                <span class="mt-7 inline-flex items-center gap-2 rounded-pill bg-coral-500 px-6 py-3 font-semibold text-white transition group-hover:bg-coral-600">
                  Voir le détail
                  <Icon name="arrow" class="h-5 w-5 transition group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          )
        }

        <!-- Pourquoi faire appel à MAGI O ? -->
        {
          service.benefits.length > 0 && (
            <div data-reveal class="mt-12 border-t border-pine-100 pt-10">
              <h3 class="text-xl font-bold text-ink">Pourquoi faire appel à {SITE.name} ?</h3>
              <div class="mt-5 flex flex-wrap gap-3">
                {service.benefits.map((b) => (
                  <span class="inline-flex items-center gap-2 rounded-pill bg-pine-50 px-4 py-2 text-sm font-medium text-pine-700">
                    <Icon name="check" class="h-4 w-4 text-coral-500" />
                    {b}
                  </span>
                ))}
              </div>
            </div>
          )
        }

        <!-- FAQ dédiée au service -->
        {
          service.faq && service.faq.length > 0 && (
            <div data-reveal class="mt-12 border-t border-pine-100 pt-10">
              <h3 class="text-2xl font-bold text-ink sm:text-3xl">Questions fréquentes</h3>
              <div class="mt-6 space-y-4">
                {service.faq.map((item) => (
                  <div class="faq-item overflow-hidden rounded-2xl border border-pine-100 bg-white shadow-soft">
                    <button type="button" class="faq-trigger flex w-full items-center justify-between gap-4 p-5 text-left" aria-expanded="false">
                      <span class="text-[17px] font-semibold text-ink">{item.q}</span>
                      <span class="faq-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-pine-50 text-pine-600">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="h-5 w-5"><path d="M12 5v14M5 12h14" /></svg>
                      </span>
                    </button>
                    <div class="faq-body">
                      <div>
                        <p class="px-5 pb-5 leading-relaxed text-pine-700/80">{item.a}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ===== CTA — composant partagé ===== -->
  <Cta
    title="Parlons de votre projet."
    text={`Devis gratuit et sans engagement pour vos travaux de ${service.title.toLowerCase()} à ${CONTACT.cityName} et ses environs. On s'occupe du reste.`}
  />

  <!-- Accordéon FAQ (exclusif) — identique à l'accueil -->
  <script is:inline>
    (() => {
      const items = document.querySelectorAll('.faq-item');
      items.forEach((item) => {
        const trigger = item.querySelector('.faq-trigger');
        if (!trigger) return;
        trigger.addEventListener('click', () => {
          const isOpen = item.classList.contains('is-open');
          items.forEach((other) => {
            other.classList.remove('is-open');
            other.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
          });
          if (!isOpen) {
            item.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });
    })();
  </script>
</Layout>
