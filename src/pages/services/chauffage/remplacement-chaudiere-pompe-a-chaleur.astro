---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Cta from '../../../components/Cta.astro';
import { CONTACT, SITE } from '../../../consts';
import { PAC } from '../../../data/pac';
---

<Layout
  seoTitle={PAC.seoTitle}
  description={PAC.description}
  image={PAC.image}
  faq={PAC.faq}
  breadcrumb={[
    { name: 'Accueil', url: '/' },
    { name: 'Nos services', url: '/services/' },
    { name: 'Chauffage', url: '/services/chauffage/' },
    { name: 'Chaudière vers pompe à chaleur' },
  ]}
>
  <PageHeader
    eyebrow="Chauffage"
    title={PAC.h1}
    subtitle="Étude de l'installation existante, dimensionnement, pose et mise en service."
  />

  <!-- ===================== INTRO ===================== -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      {
        PAC.lead.map((p, i) => (
          <p
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
            class="mt-5 text-lg leading-relaxed text-pine-700/80 first:mt-0"
          >
            {p}
          </p>
        ))
      }
    </div>
  </section>

  <!-- ===================== POURQUOI ===================== -->
  <section class="bg-pine-50/50 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h2 data-reveal class="text-3xl font-bold text-ink sm:text-4xl">{PAC.pourquoi.titre}</h2>
      {
        PAC.pourquoi.paragraphes.map((p, i) => (
          <p
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
            class="mt-5 text-lg leading-relaxed text-pine-700/80"
          >
            {p}
          </p>
        ))
      }
    </div>
  </section>

  <!-- ===================== ETAPES ===================== -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <h2 data-reveal class="text-3xl font-bold text-ink sm:text-4xl">
        Comment se déroule le remplacement
      </h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          PAC.etapes.map((e, i) => (
            <li
              data-reveal
              data-reveal-delay={String((i % 4) + 1)}
              class="flex min-w-0 gap-4 rounded-3xl bg-white p-6 shadow-soft"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-pine-700 font-bold text-white">
                {i + 1}
              </span>
              <div class="min-w-0">
                <h3 class="break-words text-lg font-bold text-ink">{e.titre}</h3>
                <p class="mt-2 break-words leading-relaxed text-pine-700/80">{e.texte}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="bg-pine-50/50 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h2 data-reveal class="text-3xl font-bold text-ink sm:text-4xl">Questions fréquentes</h2>
      <div class="mt-8 space-y-4">
        {
          PAC.faq.map((item) => (
            <div class="faq-item overflow-hidden rounded-2xl border border-pine-100 bg-white shadow-soft">
              <button
                type="button"
                class="faq-trigger flex w-full items-center justify-between gap-4 p-5 text-left"
                aria-expanded="false"
              >
                <span class="min-w-0 break-words text-[17px] font-semibold text-ink">{item.q}</span>
                <span class="faq-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-pine-50 text-pine-600">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    class="h-5 w-5"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </button>
              <div class="faq-body">
                <div>
                  <p class="px-5 pb-5 leading-relaxed text-pine-700/80">{item.a}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <p data-reveal class="mt-10 leading-relaxed text-pine-700/80">
        Retour à l'ensemble de nos prestations de
        <a href="/services/chauffage/" class="font-semibold text-coral-500">chauffage à Colmar</a>,
        ou appelez {SITE.name} au
        <a href={`tel:${CONTACT.phoneRaw}`} class="font-semibold text-coral-500">{CONTACT.phone}</a>.
      </p>
    </div>

    <script is:inline>
      (() => {
        document.querySelectorAll('.faq-item').forEach((item) => {
          const trigger = item.querySelector('.faq-trigger');
          if (!trigger) return;
          trigger.addEventListener('click', () => {
            const ouvert = item.classList.contains('is-open');
            document.querySelectorAll('.faq-item').forEach((autre) => {
              autre.classList.remove('is-open');
              autre.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
            });
            if (!ouvert) {
              item.classList.add('is-open');
              trigger.setAttribute('aria-expanded', 'true');
            }
          });
        });
      })();
    </script>
  </section>

  <Cta
    class="mb-24"
    title="Votre chaudière arrive en fin de vie ?"
    text="Contactez MAGI O pour une étude de votre installation et un devis gratuit."
  />
</Layout>
