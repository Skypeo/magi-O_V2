  <!-- Carrousel avis : boucle infinie (clonage) + flèches + défilement auto -->
  <script is:inline>
    (() => {
      const track = document.getElementById('reviews-track');
      if (!track) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Duplique la série de cartes : [originaux][clones]. Quand on dépasse la
      // 1re moitié, on recule instantanément d'une demi-largeur → boucle sans saut visible.
      const originals = Array.from(track.children);
      originals.forEach((c) => {
        const clone = c.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      });

      const step = () => {
        const card = track.querySelector('article');
        const gap = parseFloat(getComputedStyle(track).columnGap || '24') || 24;
        return card ? card.getBoundingClientRect().width + gap : track.clientWidth;
      };
      const half = () => track.scrollWidth / 2;

      // Recale la position dans la 1re moitié sans animation (effet infini).
      let recaling = false;
      const normalize = () => {
        if (recaling) return;
        const h = half();
        if (track.scrollLeft >= h) {
          recaling = true;
          track.scrollLeft -= h;
          recaling = false;
        } else if (track.scrollLeft < 0) {
          recaling = true;
          track.scrollLeft += h;
          recaling = false;
        }
      };
      track.addEventListener('scroll', normalize, { passive: true });

      const go = (dir) => {
        // Avant d'aller à gauche depuis le tout début, saute en avant pour avoir de la marge.
        if (dir < 0 && track.scrollLeft < step()) track.scrollLeft += half();
        track.scrollBy({ left: step() * dir, behavior: 'smooth' });
      };

      document.querySelectorAll('[data-rev-dir]').forEach((btn) => {
        btn.addEventListener('click', () => go(parseInt(btn.getAttribute('data-rev-dir'), 10)));
      });

      // Défilement automatique, en pause au survol / focus / interaction tactile
      if (!reduce) {
        let timer = null;
        const start = () => {
          if (timer) return;
          timer = setInterval(() => go(1), 4500);
        };
        const stop = () => {
          clearInterval(timer);
          timer = null;
        };
        track.addEventListener('pointerenter', stop);
        track.addEventListener('pointerleave', start);
        track.addEventListener('pointerdown', stop);
        track.addEventListener('focusin', stop);
        // Démarre uniquement quand la section est visible (économie de ressources)
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(
            (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
            { threshold: 0.2 }
          ).observe(track);
        } else {
          start();
        }
      }
    })();
  </script>
</Layout>

