---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';
import { CONTACT } from '../../consts';
import { getRealisationItems } from '../../lib/realisations';

export async function getStaticPaths() {
  const items = await getRealisationItems();
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item, others: items.filter((o) => o.slug !== item.slug).slice(0, 3) },
  }));
}

const { item, others } = Astro.props;

// La galerie inclut la photo principale en premier si elle n'y est pas déjà.
const photos = [item.imgUrl, ...item.gallery].filter(
  (url, i, arr): url is string => Boolean(url) && arr.indexOf(url) === i
);
---

<Layout
  title={item.titre}
  breadcrumb={[
    { name: 'Accueil', url: '/' },
    { name: 'Nos réalisations', url: '/realisations/' },
    { name: item.titre },
  ]}
  description={item.description ?? `Réalisation ${item.categorie} par MAGI O à Colmar.`}
  image={item.imgUrl ?? undefined}
>
  <!-- En-tête -->
  <section class="relative mt-4 overflow-hidden bg-pine-700 pb-24 pt-20 text-white lg:pt-24">
    <div class="pointer-events-none absolute -right-20 -top-10 h-80 w-80 rounded-full bg-pine-500/40 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 left-1/3 h-72 w-72 rounded-full bg-coral-500/15 blur-3xl"></div>

    <div class="relative mx-auto max-w-5xl px-6">
      <nav class="mb-5 flex items-center gap-2 text-sm text-white/60" aria-label="Fil d'Ariane">
        <a href="/" class="transition hover:text-white">Accueil</a>
        <span>/</span>
        <a href="/realisations" class="transition hover:text-white">Nos réalisations</a>
        <span>/</span>
        <span class="text-white/90">{item.titre}</span>
      </nav>

      <p class="fade-up mb-3 inline-flex items-center gap-2 rounded-pill bg-white/10 px-3 py-1 text-sm font-semibold text-pine-200 ring-1 ring-white/15">
        <span class="h-2 w-2 rounded-full bg-coral-500"></span>{item.categorie}
      </p>
      <h1 class="fade-up fade-up-1 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">{item.titre}</h1>
    </div>

    <div class="absolute bottom-0 left-0 right-0 leading-[0]">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 80V40C240 70 480 75 720 55C960 35 1200 5 1440 25V80H0Z" fill="white" />
      </svg>
    </div>
  </section>

  <!-- Contenu -->
  <section class="mx-auto max-w-5xl px-6 py-16">
    {
      item.description && (
        <div data-reveal class="mx-auto max-w-3xl">
          {item.description.split(/\n\s*\n/).map((para) => (
            <p class="mb-4 text-lg leading-relaxed text-pine-800/90 whitespace-pre-line">{para}</p>
          ))}
        </div>
      )
    }

    {
      photos.length > 0 && (
        <div data-reveal class="mt-12 grid gap-4 sm:grid-cols-2">
          {photos.map((url, i) => (
            <a
              href={url}
              target="_blank"
              rel="noopener"
              data-reveal
              data-reveal-delay={String((i % 2) + 1)}
              class={`group relative overflow-hidden rounded-3xl bg-pine-100 shadow-soft ${i === 0 ? 'sm:col-span-2' : ''}`}
            >
              <img
                src={url}
                alt={`${item.titre} — photo ${i + 1}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                class={`w-full object-cover transition duration-500 group-hover:scale-105 ${i === 0 ? 'aspect-[16/9]' : 'aspect-[4/3]'}`}
              />
            </a>
          ))}
        </div>
      )
    }
  </section>

  <!-- Autres réalisations -->
  {
    others.length > 0 && (
      <section class="bg-pine-50/60 py-20">
        <div class="mx-auto max-w-7xl px-6">
          <h2 data-reveal class="text-center text-2xl font-bold text-ink sm:text-3xl">Autres réalisations</h2>
          <div class="mt-10 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((r, i) => (
              <a
                href={`/realisations/${r.slug}`}
                data-reveal
                data-reveal-delay={String((i % 3) + 1)}
                class="realisation-card group relative block aspect-[4/5] overflow-hidden rounded-3xl bg-pine-700 shadow-soft transition duration-300 hover:-translate-y-1.5 hover:shadow-card"
              >
                {r.imgUrl ? (
                  <img src={r.imgUrl} alt={r.titre} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-700 ease-out group-hover:scale-110" />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center bg-pine-100 text-pine-400">
                    <Icon name="droplet" class="h-12 w-12" />
                  </div>
                )}
                <span class="card-diagonal pointer-events-none absolute inset-0" />
                <span class="absolute left-4 top-4 z-10 rounded-pill bg-white/90 px-3 py-1 text-xs font-semibold text-pine-600 backdrop-blur">
                  {r.categorie}
                </span>
                <div class="absolute inset-x-0 bottom-0 z-10 flex flex-col gap-3 p-6">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-pine-700 shadow-soft transition duration-300 group-hover:bg-coral-500 group-hover:text-white">
                    <Icon name="arrow" class="h-5 w-5 -rotate-45 transition duration-300 group-hover:rotate-0" />
                  </span>
                  <h3 class="text-xl font-bold leading-tight text-white drop-shadow-sm">{r.titre}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <Cta
    class="mt-20 mb-0"
    title="Un projet similaire ?"
    text="Devis gratuit et sans engagement, réponse rapide. Parlons de votre projet."
  />
</Layout>

<style>
  /* Overlay vert diagonal sur les cartes « Autres réalisations ». */
  .card-diagonal {
    background: linear-gradient(150deg, rgba(132, 199, 185, 0.35) 0%, rgba(68, 101, 94, 0.55) 40%, rgba(53, 71, 67, 0.96) 100%);
    clip-path: polygon(0 62%, 100% 80%, 100% 100%, 0 100%);
    transition: clip-path 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .realisation-card:hover .card-diagonal {
    clip-path: polygon(0 30%, 100% 56%, 100% 100%, 0 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .card-diagonal,
    .realisation-card img {
      transition: none;
    }
  }
</style>
