---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';
import { SERVICES, CONTACT, SITE } from '../../consts';
import { ZONES, SECTEURS } from '../../data/zones';
import type { Zone } from '../../data/zones';
import { getRealisationItems } from '../../lib/realisations';
import type { RealisationItem } from '../../lib/realisations';

export async function getStaticPaths() {
  const chantiers = await getRealisationItems();
  return ZONES.map((zone) => ({
    params: { commune: zone.slug },
    props: {
      zone,
      // Les chantiers dont le texte mentionne la commune remontent ici.
      // Tant que la cliente n'a rien saisi dans Sanity, la section n'existe pas.
      chantiers: chantiers.filter((c) =>
        `${c.titre} ${c.description ?? ''}`.toLowerCase().includes(zone.nom.toLowerCase())
      ),
      voisines: ZONES.filter((z) => z.secteur === zone.secteur && z.slug !== zone.slug).slice(0, 5),
    },
  }));
}

interface Props {
  zone: Zone;
  chantiers: RealisationItem[];
  voisines: Zone[];
}

const { zone, chantiers, voisines } = Astro.props;
---

<Layout
  seoTitle={`Plombier chauffagiste à ${zone.nom} (68) · MAGI O`}
  description={`MAGI O intervient à ${zone.nom} pour la plomberie, la rénovation de salle de bain, le chauffage et la recherche de fuite sans casse. Devis gratuit.`}
  faq={zone.faq}
  serviceLocal={{
    nom: `Plombier chauffagiste à ${zone.nom}`,
    description: zone.prestations,
    zone: zone.nom,
  }}
  breadcrumb={[
    { name: 'Accueil', url: '/' },
    { name: "Zone d'intervention", url: '/zones/' },
    { name: zone.nom },
  ]}
>
  <PageHeader
    eyebrow={SECTEURS[zone.secteur]}
    title={zone.h1}
    subtitle={zone.accroche}
  />

  <!-- ===================== SITUATION ===================== -->
  <section class="relative py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <p data-reveal class="text-lg leading-relaxed text-pine-700/80">{zone.intro}</p>
      <h2 data-reveal class="mt-10 text-2xl font-bold text-ink sm:text-3xl">{zone.titreBati}</h2>
      <p data-reveal class="mt-5 leading-relaxed text-pine-700/80">{zone.contexte}</p>
      <p data-reveal class="mt-4 leading-relaxed text-pine-700/80">{zone.habitat}</p>
      <p data-reveal data-reveal-delay="1" class="mt-4 leading-relaxed text-pine-700/80">
        {zone.angle}
      </p>
      <p data-reveal data-reveal-delay="2" class="mt-4 leading-relaxed text-pine-700/80">
        {zone.precision}
      </p>
      <p data-reveal data-reveal-delay="2" class="mt-4 text-sm text-muted">
        {zone.nom} compte environ {zone.population.toLocaleString('fr-FR')} habitants.
      </p>
      <div data-reveal data-reveal-delay="2" class="mt-8 flex flex-wrap gap-3">
        <a
          href={`tel:${CONTACT.phoneRaw}`}
          class="btn-sheen group inline-flex items-center gap-2 rounded-pill bg-coral-500 px-6 py-3.5 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-coral-600"
        >
          <Icon name="phone" class="h-5 w-5" />
          {CONTACT.phone}
        </a>
        <a
          href="/contact/"
          class="group inline-flex items-center gap-2 rounded-pill border border-pine-200 px-6 py-3.5 font-semibold text-pine-700 transition hover:-translate-y-0.5 hover:border-pine-400"
        >
          Demander un devis
          <Icon name="arrow" class="h-5 w-5 transition group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== PRESTATIONS ===================== -->
  <section class="bg-pine-50/50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-6">
      <h2 data-reveal class="text-3xl font-bold text-ink sm:text-4xl">{zone.titrePrestations}</h2>
      <p data-reveal class="mt-5 max-w-3xl text-lg leading-relaxed text-pine-700/80">
        {zone.prestations}
      </p>
      <div class="mt-10 grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
        {
          SERVICES.map((s, i) => (
            <a
              href={`/services/${s.slug}/`}
              data-reveal
              data-reveal-delay={String((i % 4) + 1)}
              class="group flex min-w-0 flex-col rounded-3xl bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:shadow-card"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-pine-50 text-pine-600">
                <Icon name={s.icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-5 break-words text-lg font-bold text-ink">{s.title}</h3>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-coral-500">
                En savoir plus
                <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== CHANTIERS DE LA COMMUNE ===================== -->
  {
    chantiers.length > 0 && (
      <section class="py-16 sm:py-20">
        <div class="mx-auto max-w-7xl px-6">
          <h2 data-reveal class="text-3xl font-bold text-ink sm:text-4xl">
            Nos chantiers à {zone.nom}
          </h2>
          <div class="mt-10 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
            {chantiers.map((c) => (
              <a
                href={`/realisations/${c.slug}/`}
                data-reveal
                class="group flex min-w-0 flex-col overflow-hidden rounded-3xl bg-white shadow-soft transition hover:-translate-y-1 hover:shadow-card"
              >
                {c.imgUrl && (
                  <div class="relative aspect-[4/3] overflow-hidden">
                    <img
                      src={c.imgUrl}
                      alt={c.titre}
                      width="500"
                      height="375"
                      loading="lazy"
                      class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="p-6">
                  <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">
                    {c.categorie}
                  </p>
                  <h3 class="mt-2 break-words text-lg font-bold text-ink">{c.titre}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ===================== FAQ DE LA COMMUNE ===================== -->
  <section class="bg-pine-50/50 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h2 data-reveal class="text-3xl font-bold text-ink sm:text-4xl">{zone.titreFaq}</h2>
      <div class="mt-8 space-y-4">
        {
          zone.faq.map((item) => (
            <div class="faq-item overflow-hidden rounded-2xl border border-pine-100 bg-white shadow-soft">
              <button
                type="button"
                class="faq-trigger flex w-full items-center justify-between gap-4 p-5 text-left"
                aria-expanded="false"
              >
                <span class="min-w-0 break-words text-[17px] font-semibold text-ink">{item.q}</span>
                <span class="faq-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-pine-50 text-pine-600">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="h-5 w-5">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </button>
              <div class="faq-body">
                <div>
                  <p class="px-5 pb-5 leading-relaxed text-pine-700/80">{item.a}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <script is:inline>
      (() => {
        document.querySelectorAll('.faq-item').forEach((item) => {
          const trigger = item.querySelector('.faq-trigger');
          if (!trigger) return;
          trigger.addEventListener('click', () => {
            const ouvert = item.classList.contains('is-open');
            document.querySelectorAll('.faq-item').forEach((autre) => {
              autre.classList.remove('is-open');
              autre.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
            });
            if (!ouvert) {
              item.classList.add('is-open');
              trigger.setAttribute('aria-expanded', 'true');
            }
          });
        });
      })();
    </script>
  </section>

  <!-- ===================== COMMUNES VOISINES ===================== -->
  {
    voisines.length > 0 && (
      <section class="py-16 sm:py-20">
        <div class="mx-auto max-w-3xl px-6">
          <h2 data-reveal class="text-2xl font-bold text-ink sm:text-3xl">
            Nous intervenons aussi autour de {zone.nom}
          </h2>
          <div data-reveal class="mt-6 flex flex-wrap gap-2.5">
            {voisines.map((v) => (
              <a
                href={`/zones/${v.slug}/`}
                class="rounded-pill border border-pine-200 px-4 py-2 text-sm font-semibold text-pine-700 transition hover:-translate-y-0.5 hover:border-pine-400"
              >
                {v.nom}
              </a>
            ))}
            <a
              href="/zones/"
              class="rounded-pill bg-pine-700 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-pine-800"
            >
              Toute la zone
            </a>
          </div>
        </div>
      </section>
    )
  }

  <Cta
    class="mb-24"
    title={`Un projet ou une fuite à ${zone.nom} ?`}
    text={zone.accroche}
  />
</Layout>
