---
import '../styles/global.css';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE, CONTACT, SOCIAL, REVIEWS } from '../consts';
import type { Service, FaqItem } from '../consts';

interface Props {
  title?: string;
  /** Title complet repris verbatim, sans suffixe de marque ajoute */
  seoTitle?: string;
  description?: string;
  image?: string;
  /** Service decrit par la page : produit un noeud Service dans le graphe */
  service?: Service;
  /** Questions/reponses visibles sur la page : produit un noeud FAQPage */
  faq?: FaqItem[];
  /** Fil d'Ariane, le dernier element etant la page courante (sans url) */
  breadcrumb?: { name: string; url?: string }[];
}

const {
  title,
  seoTitle,
  description = SITE.description,
  image = '/images/hero-bg.jpg',
  service,
  faq,
  breadcrumb,
} = Astro.props;

const pageTitle =
  seoTitle ?? (title ? `${title} · ${SITE.name}` : `${SITE.name} · Plombier chauffagiste à ${SITE.city}`);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// Schema.org — clé du SEO local pour un artisan.
// On ne référence les réseaux sociaux (sameAs) que s'ils ne sont pas
// des placeholders (URL = simple domaine racine).
const socialLinks = [SOCIAL.facebook, SOCIAL.instagram].filter(
  (u) => u && !/^https?:\/\/(www\.)?(facebook|instagram)\.com\/?$/.test(u)
);
const business = {
  '@type': 'Plumber',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: CONTACT.phoneRaw,
  email: CONTACT.email,
  image: ogImage,
  logo: new URL('/images/logo.png', Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.address,
    postalCode: CONTACT.zip,
    addressLocality: CONTACT.cityName,
    addressCountry: 'FR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 48.0794, longitude: 7.3585 },
  hasMap: CONTACT.mapsUrl,
  areaServed: { '@type': 'City', name: 'Colmar' },
  ...(socialLinks.length ? { sameAs: socialLinks } : {}),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  },
  priceRange: '€€',
  // Avis réellement affichés sur le site, repris de la fiche Google. Google
  // n'affiche pas d'étoiles pour des avis auto-hébergés sur une LocalBusiness :
  // c'est posé pour les moteurs de réponse, pas pour le rich snippet.
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(REVIEWS.rating),
    reviewCount: String(REVIEWS.items.length),
    bestRating: '5',
  },
  review: REVIEWS.items.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.name },
    reviewRating: { '@type': 'Rating', ratingValue: String(r.rating), bestRating: '5' },
    reviewBody: r.text,
  })),
};

// Un seul nœud entreprise, référencé partout ailleurs par son @id : sans cela,
// un moteur croit avoir affaire à autant d'entreprises qu'il y a de pages.
const graph: Record<string, unknown>[] = [
  business,
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    inLanguage: 'fr-FR',
    publisher: { '@id': `${SITE.url}/#business` },
  },
];

if (service) {
  graph.push({
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: service.h1 ?? service.title,
    serviceType: service.title,
    description: service.description,
    provider: { '@id': `${SITE.url}/#business` },
    areaServed: { '@type': 'City', name: 'Colmar' },
    url: canonical,
  });
}

if (faq && faq.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}

if (breadcrumb && breadcrumb.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#fil`,
    itemListElement: breadcrumb.map((etape, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: etape.name,
      ...(etape.url ? { item: new URL(etape.url, Astro.site).href } : {}),
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32-2.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#44655e" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- DM Sans auto-hébergée (aucune connexion externe). On précharge la
         tranche latine (la plus utilisée) pour accélérer le rendu du texte. -->
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="overflow-x-hidden">
    <Loader />
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-pine-500 focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <!-- Bouton « retour en haut » (toutes tailles d'écran) -->
    <button
      id="back-to-top"
      type="button"
      aria-label="Revenir en haut de la page"
      class="group invisible fixed bottom-5 right-5 z-40 flex h-12 w-12 translate-y-3 items-center justify-center rounded-full bg-pine-700 text-white opacity-0 shadow-card ring-1 ring-white/10 transition-all duration-300 hover:-translate-y-1 hover:bg-coral-500 hover:shadow-coral-500/40 sm:bottom-7 sm:right-7 sm:h-14 sm:w-14"
    >
      <span class="pointer-events-none absolute inset-0 rounded-full bg-coral-500/30 opacity-0 transition-opacity duration-300 group-hover:animate-ping group-hover:opacity-100"></span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="relative h-6 w-6 transition-transform duration-300 group-hover:-translate-y-0.5">
        <path d="m18 15-6-6-6 6" />
      </svg>
    </button>

    <script is:inline>
      (() => {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        let visible = false;
        let ticking = false;
        const update = () => {
          const show = window.scrollY > 400;
          if (show !== visible) {
            visible = show;
            btn.classList.toggle('invisible', !show);
            btn.classList.toggle('opacity-0', !show);
            btn.classList.toggle('translate-y-3', !show);
          }
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        update();
        btn.addEventListener('click', () => {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      })();
    </script>

    <!-- Couche motion : progression, parallax, compteurs, titres masqués -->
    <script is:inline>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1) Parallax doux
        const parallax = Array.from(document.querySelectorAll('[data-parallax]'));

        let ticking = false;
        const onScroll = () => {
          if (!reduce && parallax.length) {
            const vh = window.innerHeight;
            for (const el of parallax) {
              const r = el.getBoundingClientRect();
              const speed = parseFloat(el.getAttribute('data-parallax')) || 0.12;
              const offset = (r.top + r.height / 2 - vh / 2) * -speed;
              el.style.setProperty('--py', `${offset.toFixed(1)}px`);
            }
          }
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(onScroll);
            }
          },
          { passive: true }
        );
        onScroll();

        // 3) Titres « masqués » qui montent
        if ('IntersectionObserver' in window) {
          const maskIO = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  maskIO.unobserve(e.target);
                }
              });
            },
            { threshold: 0.3 }
          );
          document.querySelectorAll('.reveal-mask').forEach((el) => maskIO.observe(el));
        }

        // 4) Compteurs animés
        const counters = document.querySelectorAll('[data-count]');
        if (counters.length && 'IntersectionObserver' in window) {
          const run = (el) => {
            const target = parseFloat(el.getAttribute('data-count'));
            const suffix = el.getAttribute('data-suffix') || '';
            const prefix = el.getAttribute('data-prefix') || '';
            if (reduce) {
              el.textContent = prefix + target + suffix;
              return;
            }
            const dur = 1400;
            const t0 = performance.now();
            const step = (t) => {
              const p = Math.min((t - t0) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = prefix + Math.round(target * eased) + suffix;
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          };
          const cIO = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  run(e.target);
                  cIO.unobserve(e.target);
                }
              });
            },
            { threshold: 0.5 }
          );
          counters.forEach((el) => cIO.observe(el));
        }
      })();
    </script>

    <!-- Apparition au scroll : IntersectionObserver natif, ultra léger -->
    <script is:inline>
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
